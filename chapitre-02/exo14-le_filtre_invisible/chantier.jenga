#!/usr/bin/env python3
# -*- coding: utf-8 -*-

# chantier - Jenga Workspace
# Exercice 14 : filtre Android ajoute apres installation du NDK

from Jenga import *

with workspace("chantier"):
    configurations(['Debug', 'Release'])
    targetoses([TargetOS.WINDOWS, TargetOS.LINUX, TargetOS.ANDROID])
    targetarchs([TargetArch.X86_64, TargetArch.ARM64])

    with project("CabineTest"):
        consoleapp()
        language("C++")
        location("CabineTest")
        files(["main.cpp"])

        with filter("system:Android"):
            usetoolchain("ndk-clang")
            androidabis(["arm64-v8a"])
            androidminsdk(29)
            defines(["PLATEFORME_ANDROID"])
            links(["EGL", "GLESv3", "android", "log"])
