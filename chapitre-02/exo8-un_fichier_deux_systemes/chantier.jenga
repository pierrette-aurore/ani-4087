#!/usr/bin/env python3
# -*- coding: utf-8 -*-

# chantier - Jenga Workspace
# Exercice 8 : un seul fichier de projet, deux systemes

from Jenga import *

with workspace("chantier"):
    configurations(['Debug', 'Release'])
    targetoses([TargetOS.WINDOWS, TargetOS.LINUX, TargetOS.ANDROID])
    targetarchs([TargetArch.X86_64, TargetArch.ARM64])

    with project("CabineTest"):
        consoleapp()
        language("C++")
        location("CabineTest")
        files(["main.cpp"])

        with filter("system:Windows"):
            links(["kernel32", "user32", "winmm"])

        with filter("system:Linux"):
            links(["pthread", "dl"])
